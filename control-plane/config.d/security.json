// =============================================================================
// SECURITY — sandbox, nhật ký kiểm toán, che dữ liệu nhạy cảm
// -----------------------------------------------------------------------------
// Mô hình mối đe doạ thực tế KHÔNG phải "model bị hack", mà là:
//     "có người nhắn cho bot và bot làm đúng như họ bảo".
// Thứ tự phòng thủ:
//     (1) DANH TÍNH — ai được nhắn?   → dmPolicy/allowFrom trong channels.json
//     (2) PHẠM VI   — bot làm được gì? → tools.allow/deny + sandbox
//     (3) MODEL     — luôn giả định model có thể bị dẫn dụ
//
// SCHEMA: `logging.audit` chỉ nhận {enabled, executionIdentity, messages}.
// Che dữ liệu nhạy cảm dùng `logging.redactPatterns` (cấp trên, không nằm trong
// audit). Không có logging.audit.path/format/include.
//
// Chạy `openclaw security audit` sau MỌI thay đổi cấu hình.
// =============================================================================
{
  logging: {
    level: "info",
    // Ghi nhật ký kiểm toán: sự kiện run, tool call, và tin nhắn.
    audit: {
      enabled: true,
      executionIdentity: true,
      messages: "all",   // off | direct | all
    },
    // Che secret trước khi ghi log.
    redactPatterns: [
      "sk-[A-Za-z0-9_-]{16,}",
      "ghp_[A-Za-z0-9]{20,}",
      "xox[bapr]-[A-Za-z0-9-]{10,}",
      "Bearer [A-Za-z0-9._-]{20,}",
    ],
  },

  agents: {
    defaults: {
      sandbox: {
        mode: "all",             // mọi tool chạy trong container tách biệt
        scope: "agent",          // agent này không thấy filesystem của agent khác
        workspaceAccess: "rw",
      },
    },
  },
}
