# =============================================================================
# langgraph — bộ điều phối bền vững
# -----------------------------------------------------------------------------
# Ảnh này cần acpx bên trong vì mỗi nút của đồ thị gọi một vai trò agent.
# =============================================================================
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client jq \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

ARG ACPX_VERSION=latest
RUN npm install -g "acpx@${ACPX_VERSION}" && npm cache clean --force

# Container này chạy bằng root (mount /root/.acpx trong compose/K8s giả định
# vậy), nhưng thư mục /srv/repos là volume DÙNG CHUNG với agent-runner — nơi
# tạo worktree/repo lại chạy bằng user `node` (uid 1000). Git 2.35+ chặn thao
# tác trên repo không cùng chủ sở hữu tiến trình ("dubious ownership", vá
# CVE-2022-24765): `prepare()` trong graph.py chết ngay ở `git fetch` với
# "fatal: detected dubious ownership in repository at '/srv/repos/...'".
# Tin toàn bộ /srv/repos vì đó là volume nội bộ do chính fleet quản lý.
RUN git config --system --add safe.directory '*'

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --upgrade pip && pip install .

COPY langgraph.json ./

EXPOSE 8000
# KHÔNG dùng `langgraph up`: lệnh đó thuộc gói `langgraph-cli` (không có trong
# `langgraph`) và nó dựng Docker Compose — sai tầng khi đã ở trong container.
CMD ["uvicorn", "fleet.server:app", "--host", "0.0.0.0", "--port", "8000"]
