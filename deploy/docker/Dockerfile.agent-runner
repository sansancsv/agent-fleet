# =============================================================================
# agent-runner — ảnh chứa acpx + mcporter + toàn bộ backend agent
# -----------------------------------------------------------------------------
# Đây là nơi công việc thật diễn ra. Ba nguyên tắc:
#   1. KHÔNG chạy bằng root. Agent có quyền exec — chạy root là tự mở cửa.
#   2. Ghim phiên bản. "latest" trong ảnh production là nguồn của sự cố khó tái hiện.
#   3. Cài đủ công cụ mà agent cần (git, gh, ripgrep, jq, yq), không hơn.
# =============================================================================
FROM node:24-bookworm-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client jq ripgrep less \
      python3 python3-venv build-essential \
      socat netcat-openbsd \
 && curl -fsSL https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -o /usr/local/bin/yq \
 && chmod +x /usr/local/bin/yq \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# --- Chính npm ----------------------------------------------------------------
# npm đi kèm ảnh node:24 (11.19.0) mang tar, brace-expansion, ip-address dính CVE
# mức HIGH đã có bản vá, và trivy trong CI chặn ảnh vì chúng. Nâng npm trong
# CÙNG major (không nhảy sang npm 12) trước khi cài mọi thứ khác.
ARG NPM_VERSION=11
RUN npm install -g "npm@${NPM_VERSION}" \
 && npm cache clean --force

# --- Công cụ fleet. GHIM PHIÊN BẢN ở môi trường thật. ------------------------
ARG ACPX_VERSION=latest
ARG MCPORTER_VERSION=latest
RUN npm install -g \
      "acpx@${ACPX_VERSION}" \
      "mcporter@${MCPORTER_VERSION}" \
 && npm cache clean --force

# --- Các backend agent (ACP adapter) ----------------------------------------
# Cài đúng những backend mà fleet dùng. Thêm/bớt ở đây, không sửa code. Tên
# binary phải khớp `argv` trong execution-plane/config/acpx.global.json.
#
# Mỗi adapter tự mang runtime của nó, đúng bản phát hành cùng adapter, nên
# KHÔNG cài thêm @anthropic-ai/claude-code hay @openai/codex toàn cục: bản toàn
# cục chỉ là bản thứ hai, không ghim, không nằm trên đường chạy.
#   - claude-agent-acp chạy binary Claude Code native của
#     @anthropic-ai/claude-agent-sdk (optional dependency theo nền tảng).
#   - codex-acp từ 2.x là gói Node (không còn là binary Rust), chạy
#     `codex app-server` của @openai/codex trong cây phụ thuộc của chính nó.
# Gọi CLI bên dưới khi gỡ lỗi: `claude-agent-acp --cli ...`, `codex-acp cli ...`.
ARG CLAUDE_AGENT_ACP_VERSION=0.84.0
ARG CODEX_ACP_VERSION=2.0.0
RUN npm install -g \
      "@agentclientprotocol/claude-agent-acp@${CLAUDE_AGENT_ACP_VERSION}" \
      "@agentclientprotocol/codex-acp@${CODEX_ACP_VERSION}" \
 # npm lặng lẽ bỏ qua optional dependency cài hỏng: adapter vẫn có mặt nhưng
 # chết ở lượt đầu vì thiếu binary native. Chạy thử cả hai runtime để build
 # hỏng ngay tại đây; HOME tạm vì codex ghi bí danh trợ giúp vào ~/.codex.
 # KHÔNG dùng `codex-acp --help`: bản 2.x không phân tích cờ, nó khởi động
 # server ACP và treo chờ stdin.
 && smoke="$(mktemp -d)" \
 && HOME="$smoke" claude-agent-acp --cli --version \
 && HOME="$smoke" codex-acp cli -V \
 && rm -rf "$smoke" \
 && npm cache clean --force
# codex-acp còn cần DEFAULT_AUTH_REQUEST lúc chạy để tự đăng nhập (xem //authPolicy
# trong acpx.global.json). Biến đó đặt ở env của agent-runner (compose, K8s),
# KHÔNG đặt bằng ENV ở đây: BuildKit coi mọi tên chứa AUTH là bí mật và cảnh báo.

# Gemini CLI cài riêng vì nhịp phát hành khác nhau, và KHÔNG cần adapter riêng:
# bản thân nó nói ACP qua cờ đã khai trong acpx.global.json.
RUN npm install -g @google/gemini-cli || \
    echo "CẢNH BÁO: chưa cài được @google/gemini-cli — vai trò docs-writer/analyst sẽ không chạy"

COPY --chown=node:node execution-plane /fleet/execution-plane
COPY --chown=node:node capability-plane /fleet/capability-plane
COPY --chown=node:node profiles /fleet/profiles

# Đặt lại bit thực thi: khi repo nằm trên ổ Windows (WSL /mnt/c) quyền không được giữ.
RUN find /fleet -name '*.sh' -exec chmod +x {} + \
 # Tạo SẴN mọi thư mục sẽ được gắn volume. Khi đường dẫn đã tồn tại trong image,
 # Docker khởi tạo volume theo nội dung VÀ chủ sở hữu của nó — nhờ vậy tránh
 # được lỗi volume thuộc root mà tiến trình chạy bằng node không ghi được.
 && mkdir -p /srv/repos /var/log/fleet /home/node/.acpx /home/node/.mcporter \
      /home/node/.local/share/mcporter /home/node/.cache/mcporter \
 && chown -R node:node /srv/repos /var/log/fleet /home/node

USER node
WORKDIR /srv/repos

# Không có ENTRYPOINT cố định: dịch vụ này vừa dùng cho mcporter daemon,
# vừa dùng cho worker thực thi. Lệnh cụ thể do compose/K8s truyền vào.
CMD ["sleep", "infinity"]
