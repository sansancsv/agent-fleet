# =============================================================================
# BIẾN MÔI TRƯỜNG — copy thành .env rồi điền. KHÔNG commit .env vào git.
# Ở môi trường thật hãy dùng Vault/AWS Secrets Manager qua External Secrets
# (xem deploy/k8s/30-secrets.yaml) thay vì file .env.
# =============================================================================

FLEET_ENV=staging

# --- Hạ tầng ----------------------------------------------------------------
PG_USER=fleet
PG_PASSWORD=                      # bắt buộc

# --- Khoá dịch vụ nội bộ (sinh bằng: openssl rand -hex 32) ------------------
OPENCLAW_GATEWAY_TOKEN=           # bắt buộc
# mcporter serve chưa hỗ trợ xác thực — cách ly ở tầng mạng, không phải token.
# Giữ biến này để dành cho reverse proxy đặt trước bridge nếu bạn thêm sau.
MCPORTER_BRIDGE_TOKEN=            # không bắt buộc
HOOK_SECRET_N8N=                  # bắt buộc
HOOK_SECRET_GITHUB=
HOOK_TOKEN_ALERTS=
LANGGRAPH_TOKEN=
# CẢNH BÁO: đổi khoá này sau khi đã lưu credential = mất toàn bộ credential n8n.
N8N_ENCRYPTION_KEY=               # bắt buộc, tối thiểu 32 ký tự

# --- Nhà cung cấp model -----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Model tự host cho dữ liệu mức confidential/restricted
LOCAL_LLM_BASE_URL=http://vllm:8000/v1
LOCAL_LLM_API_KEY=

# --- Tích hợp ---------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_MCP_TOKEN=
GRAFANA_MCP_URL=
GRAFANA_SA_TOKEN=
DW_READONLY_DSN=postgresql://fleet_readonly:CHANGEME@warehouse:5432/analytics
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SERVICE_CATALOG_URL=

# --- Kênh chat --------------------------------------------------------------
SLACK_BOT_TOKEN_ENGINEERING=
SLACK_APP_TOKEN_ENGINEERING=
SLACK_BOT_TOKEN_MARKETING=
SLACK_APP_TOKEN_MARKETING=
SLACK_BOT_TOKEN_FINANCE=
SLACK_APP_TOKEN_FINANCE=
TELEGRAM_BOT_TOKEN_ALERTS=

# --- ClawHub (phân phối skill nội bộ) ---------------------------------------
CLAWHUB_TOKEN=
CLAWHUB_REGISTRY_URL=             # để trống = dùng registry công khai

# --- Phiên bản (GHIM, đừng dùng "latest") -----------------------------------
# Cấu hình trong control-plane/ được kiểm chứng với đúng bản này.
# Nâng bản: đổi ở đây → make oc-validate → make up.
OPENCLAW_TAG=2026.8.1
N8N_TAG=latest

# --- Quy mô -----------------------------------------------------------------
AGENT_RUNNER_REPLICAS=2
N8N_WORKER_REPLICAS=2
OPENCLAW_GATEWAY_PORT=18789
N8N_PORT=5678
LANGGRAPH_PORT=2024
AGENT_RUNNER_TOKEN=